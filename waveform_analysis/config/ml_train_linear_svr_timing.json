{
  "datasets": [
    "datasets/central_source_all/train_validation_timing_led"
  ],
  "model": {
    "type": "linear_svr",
    "name": "linear_svr_timing",
    "C": 1.0,
    "epsilon_values": [
      0.0,
      1.0,
      2.0,
      5.0,
      10.0,
      20.0,
      50.0
    ],
    "svm_loss": "epsilon_insensitive",
    "loss": {
      "type": "variance",
      "bias_weight": 0.0
    },
    "tolerance": 0.0001,
    "max_iterations": 20000,
    "dual": "auto"
  },
  "training": {
    "device": "auto",
    "seed": 20260725,
    "batch_size": 512,
    "normalization_chunk_size": 2048,
    "svr_materialization_chunk_size": 2048,
    "num_workers": 0,
    "pin_memory": false,
    "baseline_guard_metric": null
  },
  "fit": {
    "histogram_range_ps": [
      -500.0,
      500.0
    ],
    "histogram_bin_ps": 10.0,
    "initial_half_width_ps": 500.0,
    "iteration_sigma": 2.5,
    "max_iterations": 6,
    "convergence_tolerance_ps": 0.01,
    "min_events": 100,
    "minimum_fit_bins": 9,
    "minimum_sigma_bins": 0.5
  },
  "output": {
    "train_dir": "results/all/train/linear_svr_timing"
  },
  "plotting": {
    "dpi": 180
  },
  "logging": {
    "level": "INFO"
  },
  "input_transform": "differentiate",
  "prediction": {
    "input_waveforms": "timing",
    "target": "timing_led"
  }
}
