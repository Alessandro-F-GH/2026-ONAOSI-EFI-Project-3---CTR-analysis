{
  "experiment": {
    "name": "folder_window_linear_with_shapelets",
    "output_dir": "results/studies/folder_window_linear_with_shapelets"
  },
  "data": {
    "root_folder": "processed_data/converted_runs_07-13",
    "root_glob": "*V.root",
    "recursive": false,
    "true_tof_ps": 0.0,
    "channels": {
      "energy": [1, 2],
      "polarities": [1, 1],
      "timing": [3, 4],
      "timing_polarities": [1, 1]
    }
  },
  "storage": {
  "cleanup_raw_cache_after_materialization": true,
  "cleanup_after_completed_file": true,
  "keep_checkpoints": false
  },
  "model_spaces_dir": "config/model_spaces",
  "models": ["shapelet_regressor" , "linear_svr"],
  "windows_ns": [

    {"id": "m2_p2", "start_ns": -2, "end_ns": 2},
    {"id": "m4_p2", "start_ns": -4, "end_ns": 2},

     {"id": "m2_p10", "start_ns": -2, "end_ns": 10},
    {"id": "m4_p10", "start_ns": -4, "end_ns": 10},

    {"id": "m2_p60", "start_ns": -2, "end_ns": 60},
    {"id": "m4_p60", "start_ns": -4, "end_ns": 60}

  ],
  "channel_modes": [
    "energy_to_energy",
    "timing_to_timing"
  ],
  "input_transforms": ["none"],
  "losses": [
    {"id":"var_bias", "type": "var_bias"}
  ],
  "strict_loss_compatibility": true,
  "preprocessing": {

    "subsampling_factors": [1, 4, 16],

    "common": {
      "baseline_samples": 500,
      "search_trigger_threshold_mV": 50.0,
      "analysis_crop_ns": {"before": 5.0, "after": 60.0},
      "led_threshold_mV": 7.0,
      "cfd_fraction": 0.045
    },
    "energy": {
      "denoising": {
        "enabled": true,
        "method": "butterworth_lowpass",
        "cutoff_GHz": 0.5,
        "order": 4
      }
    },
    "timing": {
      "search_trigger_threshold_mV": 100.0,
      "denoising": {"enabled": false}
    },
    "selection": {
      "energy_noise_max_mV": null,
      "energy_trigger_index_range": null,
      "minimum_events_per_split": 1
    },
    "photopeak": {"enabled": true,
    "histogram_bin_mV": 1.0,
    "search_quantile_min": 0.2,
    "smoothing_sigma_bins": 2.0,
    "initial_half_width_mV": 15.0,
    "iteration_sigma": 2.5,
    "max_iterations": 6,
    "convergence_tolerance_mV": 0.01,
    "selection_sigma_low": -2.0,
    "selection_sigma_high": 4.0},
    "io": {"step_size": "128 MB", "max_events": 0, "progress_every": 1000},
    "parallelization": {
      "preprocessing_backend": "process",
      "preprocessing_workers": 8,
      "preprocessing_chunksize": 8
    },
    "materialization_chunk_size": 2048
  },
  "split": {
    "strategy": "random",
    "seed": 20260805,
    "blind_fraction": 0.2,
    "guard_gap_events": 1000
  },
  "cross_validation": {
    "n_splits": 4,
    "shuffle": true,
    "seed": 20260805
  },
  "selection": {
    "method": "median_mad_z",
    "z_threshold": 4.0,
    "minimum_events_per_fold": 100,
    "hyperparameter_metric": "ctr_ps",
    "window_metric": "ctr_ps"
  },
  "evaluation": {
    "device": "auto",
    "batch_size": 512,
    "num_workers": 0,
    "pin_memory": false
  },
  "fit": {
    "histogram_range_ps": [-300.0, 300.0],
    "histogram_bin_ps": 5.0,
    "initial_half_width_ps": 500.0,
    "iteration_sigma": 2.5,
    "max_iterations": 6,
    "convergence_tolerance_ps": 0.01,
    "min_events": 100,
    "minimum_fit_bins": 9,
    "minimum_sigma_bins": 0.5
  },
  "reporting": {
  "plot_best_gaussian_fits": true,
  "dpi": 180,
  "voltage_from_filename": {
    "enabled": true,
    "pattern": "^(?P<voltage>\\d+(?:\\.\\d+)?)[Vv]",
    "group": "voltage",
    "plot_ctr_vs_voltage": true
  }
},
  "logging": {"level": "INFO"}
}
