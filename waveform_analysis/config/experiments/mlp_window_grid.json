{
  "name": "mlp_window_grid",
  "dataset": "datasets/central_source_all/train_validation",
  "output_dir": "results/all/experiments/mlp_window_grid_diff",
  "cross_validation": {
    "enabled": false,
    "n_splits": 5,
    "shuffle": true,
    "random_state": 20260728
  },
  "window_search": {
    "enabled": true,
    "window_before_ns": [
      1,0,
      2.0,
      3,0,
      4.0
    ],
    "window_after_ns": [
      6,
      16,
      26,
      36,
      46,
      56
    ]
  },
  "repetitions": {
    "seeds": [
      101,
      202,
      303
    ]
  },
  "search": {
    "method": "grid",
    "parameters": {
      "model.hidden_units": [
        [
          1
        ]
      ]
    }
  },
  "base_train_config": {
    "model": {
      "type": "mlp_regressor",
      "name": "mlp_regressor",
      "hidden_units": [
        1
      ],
      "activation": "identity",
      "loss": {
        "type": "mse"
      }
    },
    "optimizer": {
      "learning_rate": 0.005,
      "weight_decay": 0.0
    },
    "training": {
      "epochs": 100,
      "batch_size": 64,
      "fit_training":false,
      "normalization_chunk_size": 2048,
      "selection_metric": "validation_rmse",
      "early_stopping_patience": 10,
      "early_stopping_min_delta_ps": 0.01
    },
    "fit": {
      "histogram_bin_ps": 10.0,
      "initial_half_width_ps": 500.0,
      "iteration_sigma": 2.5,
      "max_iterations": 5,
      "min_events": 50,
      "minimum_fit_bins": 5
    },
    "plotting": {},
    "logging": {},
    "input_transform": "differentiate"
  }
}