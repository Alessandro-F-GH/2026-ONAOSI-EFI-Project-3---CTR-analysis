{
  "experiment": {
    "name": "test",
    "output_dir": "results/studies/test"
  },
  "data": {
    "root_folder": "processed_data/converted_runs_07-13",
    "root_glob": "45V-*.root",
    "recursive": false,
    "true_tof_ps": 0.0,
    "channels": {
      "energy": [
        1,
        2
      ],
      "polarities": [
        1,
        1
      ],
      "timing": [
        3,
        4
      ],
      "timing_polarities": [
        1,
        1
      ]
    }
  },
  "models": [
    "linear_test"
  ],
  "model_spaces_dir": "config/model_spaces",
  "channel_modes": [
    "energy_to_energy"  ],
  "windows_ns": [
     {
      "id": "m2_p4",
      "start_ns": -2.0,
      "end_ns": 4.0
    },
    {
      "id": "p4_p10",
      "start_ns": 4.0,
      "end_ns": 10.0
    },
    {
      "id": "p10_p20",
      "start_ns": 10.0,
      "end_ns": 20.0
    },
    {
      "id": "p20_p40",
      "start_ns": 20.0,
      "end_ns": 40.0
    },
    {
      "id": "p40_p60",
      "start_ns": 40.0,
      "end_ns": 60.0
    }
  ],
  "preprocessing": {
    "selection_store_dir": "processed_data/selected_events",
    "prepared_dir": "processed_data/ml_prepared",
    "materialized_window_ns": {
      "before": 5.0,
      "after": 60.0
    },
    "cleanup_raw_cache": true,
    "materialization_chunk_size": 4096,
    "input_variant_by_channel": {
      "energy": "denoised",
      "timing": "raw"
    },
    "subsampling_factors": [
      8
    ],
    "common": {
      "baseline_samples": 500,
      "search_trigger_threshold_mV": 50.0,
      "analysis_crop_ns": {
        "before": 5.0,
        "after": 60.0
      },
      "led_threshold_mV": 10.0,
      "cfd_fraction": 0.045
    },
    "energy": {},
    "timing": {
      "search_trigger_threshold_mV": 100.0
    },
    "selection": {
      "energy_noise_max_mV": null,
      "energy_trigger_index_range": null,
      "minimum_events": 500,
      "led_outlier_rejection": {
        "enabled": true,
        "zscore_limit": 4.0
      }
    },
    "photopeak": {
      "enabled": true,
      "histogram_bin_mV": 1.0,
      "search_quantile_min": 0.2,
      "smoothing_sigma_bins": 2.0,
      "initial_half_width_mV": 15.0,
      "iteration_sigma": 2.5,
      "max_iterations": 6,
      "convergence_tolerance_mV": 0.01,
      "selection_sigma_low": -2.0,
      "selection_sigma_high": 4.0
    },
    "denoising": {
      "enabled": true,
      "method": "butterworth_lowpass",
      "cutoff_GHz": 1.0,
      "order": 4
    },
    "io": {
      "step_size": "128 MB",
      "max_events": 0,
      "progress_every": 1000
    },
    "parallelization": {
      "preprocessing_backend": "process",
      "preprocessing_workers": 8,
      "preprocessing_chunksize": 8
    }
  },
  "validation": {
    "strategy": "holdout",
    "seed": 20260813,
    "blind_fraction": 0.2,
    "holdout_fraction": 0.2,
    "early_stop_fraction": 0.15,
    "n_splits": 5,
    "nested": {
      "outer_folds": 5,
      "inner_strategy": "holdout",
      "inner_holdout_fraction": 0.2,
      "inner_folds": 5
    }
  },
  "cross_validation": {
    "blind_fraction": 0.2,
    "n_splits": 5,
    "early_stop_fraction": 0.15,
    "seed": 20260813
  },
  "fit": {
    "min_events": 100,
    "adaptive_binning": {
      "enabled": true,
      "bins_per_fwhm": 10.0,
      "min_bin_ps": 1.0,
      "max_bin_ps": 25.0,
      "phase_count": 8
    }
  },
  "multithreshold": {
    "enabled": false
  },
  "reporting": {
    "dpi": 180,
    "voltage_pattern": "(?P<voltage>\\d+(?:\\.\\d+)?)V",
    "save_final_fit_plots": true,
    "max_ctr_to_led_ratio": 2.0,
    "top_corrections_k": 3,
    "ctr_uncertainty_bootstrap_samples": 1000,
    "window_scan_bars": true,
    "xai": {
      "enabled": true,
      "max_events": 512,
      "integrated_gradient_steps": 16
    }
  },
  "logging": {
    "level": "INFO"
  }
}
