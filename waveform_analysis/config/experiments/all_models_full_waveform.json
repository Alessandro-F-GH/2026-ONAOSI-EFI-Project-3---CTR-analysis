{
  "experiment": {
    "name": "all_models_full_waveform",
    "output_dir": "results/studies/all_models_full_waveform"
  },
  "data": {
    "root_folder": "processed_data/full_waveform",
    "root_glob": "*V-*.root",
    "recursive": false,
    "true_tof_ps": 0.0,
    "channels": {
      "energy": [
        1,
        2
      ],
      "polarities": [
        1,
        1
      ],
      "timing": [
        3,
        4
      ],
      "timing_polarities": [
        1,
        1
      ]
    }
  },
  "models": [
    "linear_svr",
    "cnn"
  ],
  "model_spaces_dir": "config/model_spaces",
  "channel_modes": [
    "energy_to_energy",
    "timing_to_timing"
  ],
  "windows_ns": [
    {
      "id": "m4_p30",
      "start_ns": -4.0,
      "end_ns": 30.0
    }
  ],
  "preprocessing": {
    "selection_store_dir": "processed_data/selected_events",
    "prepared_dir": "processed_data/ml_prepared",
    "materialized_window_ns": {
      "before": 6.0,
      "after": 40.0
    },
    "cleanup_raw_cache": true,
    "materialization_chunk_size": 4096,
    "input_variant_by_channel": {
      "energy": "denoised",
      "timing": "raw"
    },
    "subsampling_factors": [
      8
    ],
    "common": {
      "baseline_samples":100,
    "analysis_crop_ns": {
      "before": 5.0,
      "after": 60.0
    },
    "led_threshold_mV": 10.0,

    "cfd_fraction": 0.1
  },
    "energy": {
    "search_trigger_threshold_mV": 100.0
  },

  "timing": {
    "search_trigger_threshold_mV": 500.0
  },
    "selection": {
      "baseline_rmse_robust_z": 5.0,
      "energy_trigger_index_range": null,
      "minimum_events": 500,

      "led_outlier_rejection": {
        "enabled": true,
        "zscore_limit": 4.0
      }
    },
    "photopeak": {
      "enabled": true,
      "histogram_bin_mV": 1.0,
      "search_quantile_min": 0.2,
      "smoothing_sigma_bins": 2.0,
      "initial_half_width_mV": 15.0,
      "iteration_sigma": 2.5,
      "max_iterations": 6,
      "convergence_tolerance_mV": 0.01,
      "selection_sigma_low": -2.0,
      "selection_sigma_high": 4.0
    },
    "denoising": {
      "enabled": true,
      "method": "butterworth_lowpass",
      "cutoff_GHz": 1.0,
      "order": 4
    },
    "io": {
      "step_size": "128 MB",
      "max_events": 0,
      "progress_every": 1000
    },
    "parallelization": {
      "preprocessing_backend": "process",
      "preprocessing_workers": 8,
      "preprocessing_chunksize": 8
    }
  },
  "validation": {
    "strategy": "holdout",
    "seed": 20260813,
    "blind_fraction": 0.2,
    "holdout_fraction": 0.2,
    "early_stop_fraction": 0.15,
    "n_splits": 5
  },
  "cross_validation": {
    "blind_fraction": 0.2,
    "n_splits": 5,
    "early_stop_fraction": 0.15,
    "seed": 20260813
  },
  "multithreshold": {
    "enabled": false,
    "window_id": "m4_p30",
    "thresholds_mV": [
      15,
      25,
      50,
      75,
      100,
      120
    ],
    "min_thresholds": 1,
    "max_thresholds": 5,
    "kernels": [
      "linear",
      "rbf"
        ],
    "C_values": [
      1.0,
      10.0,
      100.0
    ],
    "epsilon_values_ps": [
      0.0,
      10.0,
      30.0,
      50.0,
      80.0,
      100.0
    ],
    "gamma_values": [
      "auto"
    ]
  },
  "reporting": {
    "dpi": 180,
    "voltage_pattern": "(?P<voltage>\\d+(?:\\.\\d+)?)V",
    "save_final_fit_plots": true,
    "max_ctr_to_led_ratio": 2,
    "top_corrections_k": 3,
    "ctr_uncertainty_bootstrap_samples": 1000,
    "xai": {
      "enabled": true,
      "max_events": 1024,
      "integrated_gradient_steps": 16
    }
  },
  "logging": {
    "level": "INFO"
  }
}
