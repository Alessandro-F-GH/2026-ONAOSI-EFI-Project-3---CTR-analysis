{
  "name": "mlp_experiment",
  "dataset": "datasets/central_source_47V/train_validation",
  "output_dir": "results/47V/experiments/mlp_experiment",
  "cross_validation": {
    "enabled": false,
    "n_splits": 3,
    "shuffle": true,
    "random_state": 20260727
  },
  "window_search": {
    "enabled": true,
    "window_before_ns": [
      4
    ],
    "window_after_ns": [
      6.0,
      36.0
    ]
  },
  "repetitions": {
    "seeds": [
      1,
      2,
      3
    ]
  },
  "search": {
    "method": "grid",
    "parameters": {
      "model.hidden_units": [
        [
          32,
          4
        ]
      ],
      "model.loss.type": [
        "mse"
      ],
      "model.loss.bias_weight": [
        1
      ],
      "model.loss.bias_normalization": "none"
    }
  },
  "base_train_config": {
    "model": {
      "type": "mlp_regressor",
      "name": "mlp_regressor",
      "hidden_units": [
        32
      ],
      "activation": "identity",
      "loss": {
        "type": "mse"
      }
    },
    "optimizer": {
      "learning_rate": 0.005,
      "weight_decay": 0.0001
    },
    "training": {
      "epochs": 100,
      "batch_size": 256,
      "normalization_chunk_size": 2048,
      "selection_metric": "validation_rmse"
    },
    "fit": {
      "histogram_bin_ps": 10.0,
      "initial_half_width_ps": 500.0,
      "iteration_sigma": 2.5,
      "max_iterations": 5,
      "min_events": 10,
      "minimum_fit_bins": 5,
      "convergence_tolerance_ps": 1,
      "minimum_sigma_bins": 1.0
    },
    "plotting": {},
    "logging": {}
  },
  "final_refit": {
    "enabled": false
  }
}