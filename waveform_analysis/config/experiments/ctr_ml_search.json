{
  "experiment": {
    "name": "ctr_ml_search",
    "output_dir": "results/studies/ctr_ml_search"
  },
  "data": {
    "root_folder": "processed_data/converted_runs_07-13",
    "root_glob": "*V-*.root",
    "recursive": false,
    "true_tof_ps": 0.0,
    "channels": {
      "energy": [
        1,
        2
      ],
      "polarities": [
        1,
        1
      ],
      "timing": [
        3,
        4
      ],
      "timing_polarities": [
        1,
        1
      ]
    }
  },
  "models": [

    "linear_svr",
    
    "cnn",

    "constructive_mlp"
    
    
  ],
  "model_spaces_dir": "config/model_spaces",
  "channel_modes": [
    "energy_to_energy",
    "energy_to_timing",
    "timing_to_timing"
  ],
  "windows_ns": [
    {
      "id": "m2_p2",
      "start_ns": -2.0,
      "end_ns": 2.0
    },
    {
      "id": "m4_p40",
      "start_ns": -4.0,
      "end_ns": 40.0
    }
  ],
  "preprocessing": {
    "prepared_dir": "processed_data/ml_prepared",
    "cleanup_raw_cache": true,
    "materialization_chunk_size": 4096,
    "input_variant_by_channel": {
    "energy": "denoised",
    "timing": "raw"
    },
    "subsampling_factors": [
      1
    ],
    "common": {
      "baseline_samples": 500,
      "search_trigger_threshold_mV": 50.0,
      "analysis_crop_ns": {
        "before": 5.0,
        "after": 60.0
      },
      "led_threshold_mV": 7.0,
      "cfd_fraction": 0.045
    },
    "energy": {},
    "timing": {
      "search_trigger_threshold_mV": 100.0
    },
    "selection": {
      "energy_noise_max_mV": null,
      "energy_trigger_index_range": null,
      "minimum_events": 500,
      "led_outlier_rejection": {
      "enabled": true,
      "zscore_limit": 4.0
    }
    },
    "photopeak": {
      "enabled": true,
      "histogram_bin_mV": 1.0,
      "search_quantile_min": 0.2,
      "smoothing_sigma_bins": 2.0,
      "initial_half_width_mV": 15.0,
      "iteration_sigma": 2.5,
      "max_iterations": 6,
      "convergence_tolerance_mV": 0.01,
      "selection_sigma_low": -2.0,
      "selection_sigma_high": 4.0
    },
    "denoising": {
      "enabled": true,
      "method": "butterworth_lowpass",
      "cutoff_GHz": 1.0,
      "order": 4
    },
    "io": {
      "step_size": "128 MB",
      "max_events": 0,
      "progress_every": 1000
    },
    "parallelization": {
      "preprocessing_backend": "process",
      "preprocessing_workers": 8,
      "preprocessing_chunksize": 8
    }
  },
  "cross_validation": {
    "blind_fraction": 0.2,
    "n_splits": 5,
    "early_stop_fraction": 0.15,
    "seed": 20260813
  },
  "multithreshold": {
    "enabled": true,
    "window_id": "m4_p40",
    "thresholds_mV": [
      5,
      10,
      25,
      50,
      75,
      100
    ],
    "min_thresholds": 1,
    "max_thresholds": 5,
    "kernels": [
      "linear",
      "rbf"
    ],
    "C_values": [
      1.0
    ],
    "epsilon_values_ps": [
      0.0,
      20.0,
      50.0,
      80,
      100,
      120
    ],
    "gamma_values": [
      "auto"
    ]
  },
  "reporting": {
    "dpi": 180,
    "voltage_pattern": "(?P<voltage>\\d+(?:\\.\\d+)?)V",
    "save_final_fit_plots": true,
    "xai": {
      "enabled": true,
      "max_events": 1024,
      "integrated_gradient_steps": 16
    }
  },
  "logging": {
    "level": "INFO"
  }
}
