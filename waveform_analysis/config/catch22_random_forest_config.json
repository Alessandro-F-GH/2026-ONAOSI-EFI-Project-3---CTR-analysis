{
  "model_type": "catch22_random_forest",
  "features": {
    "implementation": "aeon",
    "catch24": true,
    "outlier_norm": true,
    "replace_non_finite": true,
    "chunk_events": 2048,
    "n_jobs": -1,
    "parallel_backend": "loky",
    "use_pycatch22": true,
    "checkpoint_every_chunks": 4
  },
  "random_forest": {
    "n_estimators": 200,
    "criterion": "squared_error",
    "max_depth": null,
    "min_samples_split": 4,
    "min_samples_leaf": 2,
    "max_features": 0.75,
    "bootstrap": true,
    "max_samples": 0.8,
    "oob_score": false,
    "n_jobs": -1,
    "verbose": 0
  },
  "training": {
    "seed": 20260724,
    "stages": 3,
    "stage_learning_rate": 0.5,
    "max_abs_single_channel_output_ps": 500.0,
    "monitor": "validation_loss",
    "early_stopping_patience": 2,
    "early_stopping_min_delta": 1.0
  },
  "checkpointing": {
    "every_trees": 50
  }
}
