{
  "datasets": [
    "datasets/central_source_49V_timing_led/train_validation"
  ],
  "model": {
    "type": "mlp_regressor",
    "name": "mlp_baseline",
    "hidden_units": [128,32],
    "activation": "silu",
    "loss": {
    "type": "mse"
    },
    "dropout": 0.0,
    "batch_norm": false,
    "max_abs_single_channel_output_ps": 1000.0
  },
  "optimizer": {
    "learning_rate": 0.0001,
    "weight_decay": 0.000001
  },
  "training": {
    "device": "auto",
    "seed": 20260725,
    "fit_interval_epochs": 1,
    "fit_train_during_training": false,
    "fit_validation_during_training": true,
    "epochs": 300,
    "random_pair_swap": true,
    "batch_size": 8,
    "mixed_precision": true,
    "gradient_clip_norm": 100.0,
    "early_stopping_patience": 20,
    "early_stopping_min_delta_ps": 0.01,
    "normalization_chunk_size": 2048, 
    "num_workers": 0,
    "pin_memory": false,
    "selection_metric": "validation_rmse"
  },
  "fit": {
    "histogram_range_ps": [
      -500.0,
      500.0
    ],
    "histogram_bin_ps": 10.0,
    "initial_half_width_ps": 500.0,
    "iteration_sigma": 2.5,
    "max_iterations": 6,
    "convergence_tolerance_ps": 0.01,
    "min_events": 100,
    "minimum_fit_bins": 9,
    "minimum_sigma_bins": 0.5
  },
  "output": {
    "train_dir": "results/49V/train/mlp_timing_led"
  },
  
  "plotting": {
    "dpi": 180
  },
  "logging": {
    "level": "INFO"
  }
}
