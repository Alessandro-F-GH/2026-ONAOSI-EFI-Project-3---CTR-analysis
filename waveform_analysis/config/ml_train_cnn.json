{
  "datasets": [
    "datasets/central_source_47V/train_validation"
  ],
  "model": {
    "type": "cnn_regressor",
    "name": "cnn_energy_diff_light",
    "channels": [8, 16, 24],
    "kernel_sizes": [17, 9, 5],
    "strides": [8, 4, 2],
    "dilations": [1, 1, 1],
    "activation": "silu",
    "normalization": "none",
    "conv_dropout": 0.0,
    "adaptive_pool_length": null,
    "dense_units": [1],
    "dense_dropout": 0.0,
    "loss": {
      "type": "var_bias",
      "bias_weight": 0.01,
      "bias_normalization": "target_std"
    },
    "max_abs_single_channel_output_ps": 1000.0
  },
  "optimizer": {
    "learning_rate": 0.001,
    "weight_decay": 0.0001
  },
  "training": {
    "device": "auto",
    "seed": 20260725,
    "initialization_seed": 20260725,
    "fit_interval_epochs": 1,
    "fit_train_during_training": false,
    "fit_validation_during_training": true,
    "epochs": 150,
    "random_pair_swap": false,
    "batch_size": 32,
    "mixed_precision": true,
    "gradient_clip_norm": 5.0,
    "early_stopping_patience": 10,
    "early_stopping_min_delta_ps": 0.01,
    "normalization_chunk_size": 2048,
    "num_workers": 0,
    "pin_memory": false,
    "selection_metric": "validation_ctr",
    "baseline_guard_metric": null,
    "zero_bias_constraint": {
      "enabled": false,
      "mode": "residual_mean"
    }
  },
  "fit": {
    "histogram_range_ps": [-500.0, 500.0],
    "histogram_bin_ps": 10.0,
    "initial_half_width_ps": 500.0,
    "iteration_sigma": 2.5,
    "max_iterations": 6,
    "convergence_tolerance_ps": 0.01,
    "min_events": 100,
    "minimum_fit_bins": 9,
    "minimum_sigma_bins": 0.5
  },
  "output": {
    "train_dir": "results/47V/train/cnn_energy_diff_light"
  },
  "plotting": {
    "dpi": 180
  },
  "logging": {
    "level": "INFO"
  },
  "input_transform": "differentiate",
  "prediction": {
    "input_waveforms": "energy",
    "target": "energy_led"
  }
}
