{
  "model_type": "time_series_mlp",
  "architecture": {
    "hidden_units": [
      32,
      16,
      4
    ],
    "batch_norm": true,
    "activation": "relu",
    "dropout": 0.0001,
    "max_abs_single_channel_output_ps": 1000.0
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.01,
    "weight_decay": 0.003
  },
  "scheduler": {
    "name": "reduce_on_plateau",
    "factor": 0.5,
    "patience": 5,
    "minimum_learning_rate": 1e-07
  },
  "training": {
    "device": "auto",
    "seed": 20260724,
    "epochs": 200,
    "batch_size": 256,
    "mixed_precision": true,
    "gradient_clip_norm": 1,
    "log_every_batches": 1000,
    "fit_metrics_every_epochs": 1,
    "monitor": "validation_loss",
    "early_stopping_patience": 20,
    "early_stopping_min_delta": 1e-05
  },
  "checkpointing": {
    "every_batches": 100
  }
}
