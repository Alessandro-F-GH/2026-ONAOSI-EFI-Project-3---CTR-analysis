{
  "datasets": [
    "datasets/central_source_all/train_validation_timing_led"
  ],
  "model": {
    "type": "mlp_regressor",
    "name": "mlp_timing",
    "hidden_units": [
      1
    ],
    "activation": "silu",
    "loss": {
      "type": "var_bias",
      "bias_weight": 0.01
    },
    "dropout": 0.0,
    "batch_norm": false,
    "max_abs_single_channel_output_ps": 1000.0
  },
  "optimizer": {
    "learning_rate": 0.001,
    "weight_decay": 0.0001
  },
  "training": {
    "device": "auto",
    "seed": 20260725,
    "fit_interval_epochs": 1,
    "fit_train_during_training": false,
    "fit_validation_during_training": true,
    "epochs": 300,
    "random_pair_swap": false,
    "batch_size": 64,
    "mixed_precision": true,
    "gradient_clip_norm": 10.0,
    "early_stopping_patience": 20,
    "early_stopping_min_delta_ps": 0.01,
    "normalization_chunk_size": 2048,
    "num_workers": 0,
    "pin_memory": false,
    "selection_metric": "validation_rmse",
    "zero_bias_constraint": {
      "enabled": false,
      "mode": "prediction_mean"
    }
  },
  "fit": {
    "histogram_range_ps": [
      -500.0,
      500.0
    ],
    "histogram_bin_ps": 10.0,
    "initial_half_width_ps": 500.0,
    "iteration_sigma": 2.5,
    "max_iterations": 6,
    "convergence_tolerance_ps": 0.01,
    "min_events": 100,
    "minimum_fit_bins": 9,
    "minimum_sigma_bins": 0.5
  },
  "output": {
    "train_dir": "results/all/train/mlp_timing"
  },
  "plotting": {
    "dpi": 180
  },
  "logging": {
    "level": "INFO"
  },
  "input_transform": "differentiate",
  "prediction": {
    "input_waveforms": "timing",
    "target": "timing_led"
  }
}
