{
  "model_type": "cnn",
  "architecture": {
    "conv_channels": [
      4,
      8
    ],
    "kernel_sizes": [
      9,
      5
    ],
    "pool_sizes": [
      16,
      4
    ],
    "batch_norm": true,
    "activation": "relu",
    "dropout": 0.01,
    "dense_units": [
      32
    ],
