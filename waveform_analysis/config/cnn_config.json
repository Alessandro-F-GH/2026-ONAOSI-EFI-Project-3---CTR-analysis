  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.01,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "reduce_on_plateau",
    "factor": 0.5,
    "patience": 4,
    "minimum_learning_rate": 1e-07
  },
  "training": {
    "device": "auto",
    "seed": 20260724,
    "epochs": 80,
    "batch_size": 256,
    "mixed_precision": true,
    "gradient_clip_norm": 5.0,
    "log_every_batches": 100,
    "fit_metrics_every_epochs": 1,
    "monitor": "validation_loss",
    "early_stopping_patience": 20,
    "early_stopping_min_delta": 1e-05
  },
  "checkpointing": {
    "every_batches": 100
  }
